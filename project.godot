; Engine baseline: 4.5.stable.official.876b29033 (local installation).
config_version=5

[application]
config/name="百炼成丹"
config/description="开局一座破丹炉，叩问丹道九重天。"
config/version="0.1.10-p8-catalog"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icons/cauldron.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="AlchemyThousands"

[autoload]
AppSettings="*res://scripts/autoload/app_settings.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom="res://themes/alchemy_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.047, 0.09, 0.09, 1)
